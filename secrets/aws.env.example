# Copy to aws.env and fill in (aws.env is gitignored).
# Before starting content-service:  set -a && source secrets/aws.env && set +a
# Then: cd backend/content-service && mvn spring-boot:run
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
AWS_DEFAULT_REGION=eu-north-1
S3_BUCKET=showme-1
